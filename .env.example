# ===== Banco de dados =====
# Host local (fora do docker): use localhost. Dentro do compose: use "db".
# DIRECT_URL só é usada por prisma migrate/seed; no local pode ser igual à DATABASE_URL.
DATABASE_URL="postgresql://pts:pts@localhost:5432/pts?schema=public"
DIRECT_URL="postgresql://pts:pts@localhost:5432/pts?schema=public"

# Supabase (pts-stage / pts-production) — Dashboard > Project Settings > Database:
#   DATABASE_URL = Transaction pooler (porta 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler / Direct connection (porta 5432)
# DATABASE_URL="postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ===== Autenticação (Auth.js) =====
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ===== Seed =====
# SEED_DEMO=true cria usuários/pacientes/PTS de exemplo (dev, stage, CI/e2e).
# Ausente em produção => só bootstrap (RBAC + 1 admin).
SEED_DEMO="true"
# Senha do admin criado pelo seed. Padrão dev: admin123.
# Obrigatória (e != admin123) quando SEED_DEMO != true.
# SEED_ADMIN_SENHA=""

# ===== Notificação por e-mail (issue #64) =====
# Em dev, o docker-compose já sobe MailHog em :1025 (SMTP) / :8025 (web UI).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="pts@local.test"
# E-mail da eSF/UBS que recebe a notificação de PTS aberto. Sem valor, o
# envio é pulado silenciosamente (nada é notificado, nada falha).
# NOTIFY_ESF_EMAIL=""