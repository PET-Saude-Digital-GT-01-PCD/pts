# ===== Banco de dados =====
# Host local (fora do docker): use localhost. Dentro do compose: use "db".
DATABASE_URL="postgresql://pts:pts@localhost:5432/pts?schema=public"

# ===== Autenticação (Auth.js) =====
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ===== Seed (dev) =====
# Senha do usuário admin criado pelo seed. Padrão: admin123.
# SEED_ADMIN_SENHA=""

# ===== Notificação por e-mail (issue #64) =====
# Em dev, o docker-compose já sobe MailHog em :1025 (SMTP) / :8025 (web UI).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="pts@local.test"
# E-mail da eSF/UBS que recebe a notificação de PTS aberto. Sem valor, o
# envio é pulado silenciosamente (nada é notificado, nada falha).
# NOTIFY_ESF_EMAIL=""